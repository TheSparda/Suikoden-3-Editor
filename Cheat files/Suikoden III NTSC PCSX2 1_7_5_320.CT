{$lua}

lua_aobscan_last_2("GetBasePointersAOB",process,"0F 88 05 00 00 00 E9 * * * * 8B 0D * * * * 48 63 5C 0D 00 8B 05 * * * * 89 05 * * * * 48 89 1D * * * * 8B 05 * * * * 83 C0 02 89 05 * * * * 2B 05 * * * * 0F 88 * * * * E9 * * * * 48 8B 1D * * * *",0x100000000)

local CurrentSaveSymbolList = {
"InfiniteItem",
"InfiniteGP",
"InfiniteHP",
"InfiniteRuneUse",
"QuickLevelGain",
"SetSPAllParty",
"SetAllSkillsToSS",
"SetAllPDFToMax",
"SetAllMDFToMax",
"GPMultiplier",
"MAGICMultiplier",
"CharSPMultiplier"
}

-- First, make sure Save Symbol List global variable is empty
for i=#SaveSymbolList,1,-1 do
	table.remove(SaveSymbolList,i)
end

for j=1,#CurrentSaveSymbolList do
	-- Insert our custom symbol list for this trainer into the global variable
	table.insert(SaveSymbolList,CurrentSaveSymbolList[j])
end

{$asm}

