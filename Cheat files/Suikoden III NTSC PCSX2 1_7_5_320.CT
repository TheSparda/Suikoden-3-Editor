	  <Description>"Activate Trainer (Be Sure to View Main Menu Where You See Your Money First, Then Activate Trainer, Then View Again)"</Description>
	  <Options moHideChildren="1"/>
	  <VariableType>Auto Assembler Script</VariableType>
