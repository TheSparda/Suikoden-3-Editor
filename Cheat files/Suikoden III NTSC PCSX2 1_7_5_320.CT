	  </Hotkeys>
	</CheatEntry>
	<CheatEntry>
	  <ID>3</ID>
	  <Description>"Activate Trainer 3"</Description>
	  <Options moHideChildren="1"/>
	  <VariableType>Auto Assembler Script</VariableType>
	  <AssemblerScript>[ENABLE]
{$lua}

tMainTimer = createTimer(nil, false)
tMainTimer.OnTimer = function(fMainTimer)

	local OurProcess = getAddressSafe(process)
	local ourindex = 0
	local FirstPartyItemOneQty = getAddressSafe("FirstPartyItemOneQty")
	local FirstPartyExp = getAddressSafe("FirstPartyExp")
	local CharacterInfoOffset = ReadInteger(getAddressSafe("CharacterInfoOffset"))
	local CharacterInfoNumPartyMembers = ReadInteger(getAddressSafe("CharacterInfoNumPartyMembers"))
	local BattleInfoOffset = ReadInteger(getAddressSafe("BattleInfoOffset"))
	local FirstPartyCurrentHP = getAddressSafe("FirstPartyCurrentHP")
	local BattleInfoNumPartyMembers = ReadInteger(getAddressSafe("BattleInfoNumPartyMembers"))
	
	if (FirstPartyItemOneQty ~= nil) then
		if (FirstPartyItemOneQty ~= 0) then
			-- First, Do Character Options
			while (ourindex &lt; CharacterInfoNumPartyMembers) do
				local InfiniteItem = ReadInteger(getAddressSafe("InfiniteItem"))
				
				if (InfiniteItem == 1) then
					local Item1Qty = ReadBytes(FirstPartyItemOneQty + 0x00)
					if (Item1Qty ~= 0) then
						if (ReadBytes(FirstPartyItemOneQty) ~= 9) then
							WriteBytes(FirstPartyItemOneQty,9)
						end
					end

					local Item2Qty = ReadBytes(FirstPartyItemOneQty + 0x08)
					if (Item2Qty ~= 0) then
						if (ReadBytes(FirstPartyItemOneQty+0x08) ~= 9) then
							WriteBytes(FirstPartyItemOneQty+0x08,9)
						end
					end

					local Item3Qty = ReadBytes(FirstPartyItemOneQty + 0x10)
					if (Item3Qty ~= 0) then
						if (ReadBytes(FirstPartyItemOneQty+0x10) ~= 9) then
							WriteBytes(FirstPartyItemOneQty+0x10,9)
						end
					end
				end
				
				local QuickLevelGain = ReadInteger(getAddressSafe("QuickLevelGain"))
				
				if (QuickLevelGain == 1) then
					if (ReadSmallInteger(FirstPartyExp - 0x04) ~= 999) then
						WriteSmallInteger(FirstPartyExp - 0x04,999)
					end
				end
				
				local SetSPAllParty = ReadInteger(getAddressSafe("SetSPAllParty"))
				
				if (SetSPAllParty == 1) then
					if (ReadSmallInteger(FirstPartyExp + 0x00) ~= 5000) then
						WriteSmallInteger(FirstPartyExp + 0x00,5000)
					end
				end
				
				local InfiniteRuneUse = ReadInteger(getAddressSafe("InfiniteRuneUse"))
				
				if (InfiniteRuneUse == 1) then
					local MaxRuneUse = ReadInteger(FirstPartyExp + 0x38)
					if (ReadInteger(FirstPartyExp + 0x34) ~= MaxRuneUse) then
						WriteInteger(FirstPartyExp + 0x34,MaxRuneUse)
					end
				end
				
				local SetAllSkillsToSS = ReadInteger(getAddressSafe("SetAllSkillsToSS"))
				
				if (SetAllSkillsToSS == 1) then
					local ourindex5 = 0
					while (ourindex5 &lt; 8) do
						if (ReadBytes(FirstPartyExp + 0xC + (ourindex5 * 0x02)) ~= 0) then
							if (ReadBytes(FirstPartyExp + 0xD + (ourindex5 * 0x02)) ~= 8) then
								WriteBytes(FirstPartyExp + 0xD + (ourindex5 * 0x02),8)
							end
						end
						
						ourindex5 = ourindex5 + 1
					end
				end
				
				local SetAllPDFToMax = ReadInteger(getAddressSafe("SetAllPDFToMax"))
				
				if (SetAllPDFToMax == 1) then
					if (ReadSmallInteger(FirstPartyExp + 0xE) ~= 999) then
						WriteSmallInteger(FirstPartyExp + 0x24,999)
					end
				end
				
				local SetAllMDFToMax = ReadInteger(getAddressSafe("SetAllMDFToMax"))
				
				if (SetAllMDFToMax == 1) then
					if (ReadSmallInteger(FirstPartyExp + 0x10) ~= 999) then
						WriteSmallInteger(FirstPartyExp + 0x26,999)
					end
				end
								
				ourindex = ourindex + 1
				FirstPartyExp = FirstPartyExp + CharacterInfoOffset
				FirstPartyItemOneQty = FirstPartyItemOneQty + CharacterInfoOffset
			end
			
			ourindex = 0
			
		end
	end
	
end

tMainTimer.Interval = 100
tMainTimer.Enabled = true

{$asm}

[DISABLE]
{$lua}

tMainTimer.destroy()

{$asm}
