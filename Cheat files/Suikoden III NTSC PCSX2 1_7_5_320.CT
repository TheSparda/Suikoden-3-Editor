	<CheatEntry>
	  <ID>202</ID>
	  <Description>"Cash (Money) Multiplier"</Description>
	  <VariableType>4 Bytes</VariableType>
	  <Address>GPMultiplier</Address>
	</CheatEntry>
	<CheatEntry>
	  <ID>225</ID>
	  <Description>"Enable MAGIC Stat Multiplier (Enable After Loading Save/Starting New Game, Not At Title Menu)"</Description>
	  <Options moHideChildren="1"/>
	  <VariableType>Auto Assembler Script</VariableType>
	  <AssemblerScript>[ENABLE]
{$lua}

WriteInteger(getAddressSafe("MAGICInitialized"),0)

tMAGICMult = createTimer(nil, false)
tMAGICMult.OnTimer = function(fMAGICMult)

  local MAGICMult = ReadFloat(getAddressSafe("MAGICMultiplier"))
  local MAGICInitialized = ReadInteger(getAddressSafe("MAGICInitialized"))
  local MAGICSaved = getAddressSafe("SavedMAGIC")
  local CharacterInfoNumPartyMembers = ReadInteger(getAddressSafe("CharacterInfoNumPartyMembers"))
  local CharacterInfoOffset = ReadInteger(getAddressSafe("CharacterInfoOffset"))
  local CurrentPartyEXPPtr = getAddressSafe("FirstPartyEXP")
  --local OurBasePtr = ReadPointer(getAddressSafe("OurBasePtr"))
  
  if (CurrentPartyEXPPtr ~= nil) then
	if (CurrentPartyEXPPtr ~= 0) then

	  if (MAGICInitialized == 0) then
		WriteInteger(getAddress("MAGICInitialized"),1)
		local ourindex = 0
		 
		while (ourindex &lt; CharacterInfoNumPartyMembers) do
			local CurrentMAGIC = ReadSmallInteger(CurrentPartyEXPPtr + (ourindex * 0x8C) + 0x20)
			if (CurrentMAGIC &lt; 0) then
				CurrentMAGIC = 32767 + CurrentMAGIC + 1
			end			
			WriteSmallInteger(MAGICSaved + (ourindex * 0x02),CurrentMAGIC)
			
			ourindex = ourindex + 1
		end
	  else
		local ourindex2 = 0
		 
		while (ourindex2 &lt; CharacterInfoNumPartyMembers) do
			local CurrentMAGIC = ReadSmallInteger(CurrentPartyEXPPtr + (ourindex2 * 0x8C) + 0x20)
			if (CurrentMAGIC &lt; 0) then
				CurrentMAGIC = 32767 + CurrentMAGIC + 1
			end
			local CurrentSavedMAGIC = ReadSmallInteger(MAGICSaved + (ourindex2 * 0x02))
			if (CurrentSavedMAGIC &lt; 0) then
				CurrentSavedMAGIC = 32767 + CurrentSavedMAGIC + 1
			end
			
			if (CurrentMAGIC ~= CurrentSavedMAGIC) then
				local DoneUpdating = 0
				local OldMAGIC = CurrentMAGIC
				
				while (DoneUpdating == 0) do
					sleep(50)
					local CurrentMAGIC2 = ReadBytes(CurrentPartyEXPPtr + (ourindex2 * 0x8C) + 0x20)
					if (CurrentMAGIC2 == OldMAGIC) then
						DoneUpdating = 1
					else
						OldMAGIC = CurrentMAGIC2
					end
				end
			end

			-- Get Last Value After Everything Is Done
			CurrentMAGIC = ReadSmallInteger(CurrentPartyEXPPtr + (ourindex2 * 0x8C) + 0x20)
			if (CurrentMAGIC &lt; 0) then
				CurrentMAGIC = 32767 + CurrentMAGIC + 1
			end
			
			local MAGICDifference = CurrentMAGIC - CurrentSavedMAGIC
			if (MAGICDifference &gt; 0) then
				--print(string.format("MAGICDifference = %d, CurrentSavedMAGIC = %d",MAGICDifference,CurrentSavedMAGIC))
				local MAGICMultiplied1 = MAGICDifference * MAGICMult
				local MAGICMultiplied = math.ceil(MAGICMultiplied1)
				local NewMAGIC = CurrentSavedMAGIC + MAGICMultiplied
				if (NewMAGIC &gt; 999) then
					NewMAGIC = 999
				end
				WriteSmallInteger(CurrentPartyEXPPtr + (ourindex2 * 0x8C) + 0x20,NewMAGIC)
				WriteSmallInteger(MAGICSaved + (ourindex2 * 0x02),NewMAGIC)
			end
			
			ourindex2 = ourindex2 + 1
		end
	  end		  

	end
  end

end
tMAGICMult.Interval = 100
tMAGICMult.Enabled = true

{$asm}

[DISABLE]
{$lua}

tMAGICMult.destroy()

{$asm}

</AssemblerScript>
