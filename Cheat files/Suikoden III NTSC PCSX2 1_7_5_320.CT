newmem2:
  mov [R15Save2],r15
  cmp rcx,196E5F0
  jne MyCleanUp2
  mov r15,OurBasePtr
  mov [r15],rbp
  jmp MyCleanUp2
  
MyCleanUp2:
  mov r15,[R15Save2]
  jmp originalcode2
  
originalcode2:
