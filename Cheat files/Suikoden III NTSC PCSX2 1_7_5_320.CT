	  <VariableType>Auto Assembler Script</VariableType>
	  <AssemblerScript>[ENABLE]
{$lua}

WriteInteger(getAddressSafe("CharSPInitialized"),0)

tCharSPMult = createTimer(nil, false)
tCharSPMult.OnTimer = function(fCharSPMult)

  local CharSPMult = ReadFloat(getAddressSafe("CharSPMultiplier"))
  local CharSPInitialized = ReadInteger(getAddressSafe("CharSPInitialized"))
  local CharSPSaved = getAddressSafe("SavedCharSP")
  local CharacterInfoNumPartyMembers = ReadInteger(getAddressSafe("CharacterInfoNumPartyMembers"))
  local CharacterInfoOffset = ReadInteger(getAddressSafe("CharacterInfoOffset"))
  local CurrentPartyEXPPtr = getAddressSafe("FirstPartyEXP")
  --local OurBasePtr = ReadPointer(getAddressSafe("OurBasePtr"))
  
  if (CurrentPartyEXPPtr ~= nil) then
	if (CurrentPartyEXPPtr ~= 0) then

	  if (CharSPInitialized == 0) then
		WriteInteger(getAddress("CharSPInitialized"),1)
		local ourindex = 0
		 
		while (ourindex &lt; CharacterInfoNumPartyMembers) do
			local CurrentCharSP = ReadSmallInteger(CurrentPartyEXPPtr + (ourindex * 0x8C) + 0x00)
			if (CurrentCharSP &lt; 0) then
				CurrentCharSP = 32767 + CurrentCharSP + 1
			end			
			WriteSmallInteger(CharSPSaved + (ourindex * 0x02),CurrentCharSP)
			
			ourindex = ourindex + 1
		end
	  else
		local ourindex2 = 0
		 
		while (ourindex2 &lt; CharacterInfoNumPartyMembers) do
			local CurrentCharSP = ReadSmallInteger(CurrentPartyEXPPtr + (ourindex2 * 0x8C) + 0x00)
			if (CurrentCharSP &lt; 0) then
				CurrentCharSP = 32767 + CurrentCharSP + 1
			end
			local CurrentSavedCharSP = ReadSmallInteger(CharSPSaved + (ourindex2 * 0x02))
			if (CurrentSavedCharSP &lt; 0) then
				CurrentSavedCharSP = 32767 + CurrentSavedCharSP + 1
			end
			
			if (CurrentCharSP ~= CurrentSavedCharSP) then
				local DoneUpdating = 0
				local OldCharSP = CurrentCharSP
				
				while (DoneUpdating == 0) do
					sleep(50)
					local CurrentCharSP2 = ReadSmallInteger(CurrentPartyEXPPtr + (ourindex2 * 0x8C) + 0x00)
					if (CurrentCharSP2 == OldCharSP) then
						DoneUpdating = 1
					else
						OldCharSP = CurrentCharSP2
					end
				end
			end

			-- Get Last Value After Everything Is Done
			CurrentCharSP = ReadSmallInteger(CurrentPartyEXPPtr + (ourindex2 * 0x8C) + 0x00)
			if (CurrentCharSP &lt; 0) then
				CurrentCharSP = 32767 + CurrentCharSP + 1
			end
			
			local CharSPDifference = CurrentCharSP - CurrentSavedCharSP
			if (CharSPDifference &gt; 0) then
				--print(string.format("CharSPDifference = %d, CurrentSavedCharSP = %d",CharSPDifference,CurrentSavedCharSP))
				local CharSPMultiplied1 = CharSPDifference * CharSPMult
				local CharSPMultiplied = math.ceil(CharSPMultiplied1)
				local NewCharSP = CurrentSavedCharSP + CharSPMultiplied
				if (NewCharSP &gt; 9999) then
					NewCharSP = 9999
				end
				WriteSmallInteger(CurrentPartyEXPPtr + (ourindex2 * 0x8C) + 0x00,NewCharSP)
				WriteSmallInteger(CharSPSaved + (ourindex2 * 0x02),NewCharSP)
			else
				if (CharSPDifference &lt; 0) then
					WriteSmallInteger(CharSPSaved + (ourindex2 * 0x02),CurrentCharSP)
				end
			end
			
			ourindex2 = ourindex2 + 1
		end
	  end		  

	end
  end

end
tCharSPMult.Interval = 100
tCharSPMult.Enabled = true

{$asm}

[DISABLE]
{$lua}

tCharSPMult.destroy()

{$asm}

</AssemblerScript>
	</CheatEntry>
