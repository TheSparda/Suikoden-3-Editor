# Game images — never commit (large, copyrighted)
*.iso
*.bin
*.img
ISO/

# Backups the editor makes before writing
*.bak
*.bak_*
*.TEST.iso
*.webtest.iso

# Shareable patches / recipes (contain changed game bytes) — not distributed
*.s3mod
*.s3mod.json
*.xdelta

# Python
__pycache__/
*.pyc

# Release build output (built locally by make_release.py, uploaded to GitHub Releases)
dist/

# macOS
.DS_Store

# third-party binary — not distributed
Editor/Suikoden3EditorV12b.exe

# third-party decompiled source — not distributed
Editor/Suikoden3Editor_decompiled.cs

# editor/session config — not part of the project.
# Ignore local session state, but keep the shared hook + its settings tracked
# (they pin cloud-session commit authorship to TheSparda).
.claude/*
!.claude/settings.json
!.claude/hooks/
Saves/

# local cheat/reference files — not distributed
Cheat files/
Guides/

# web test deps
web/tests/node_modules
